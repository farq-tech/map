"CFBundleDisplayName" = "سَرى البارق";
"NSLocationWhenInUseUsageDescription" = "يعرض سَرى البارق موقعك على خريطة الطلعة، ويشاركه مع أعضاء الطلعة فقط بعد ما تختار «شارك موقعي».";
"NSMicrophoneUsageDescription" = "يسجّل صوتك فقط وأنت ضاغط على «اضغط وتكلم»، ويُرسل المقطع لأعضاء الطلعة. يُحذف من الخادم بعد ١٠ دقائق.";
"NSCameraUsageDescription" = "تُستخدم الكاميرا فقط لمسح رمز QR: رمز دعوة طلعة، أو رمز الاسترجاع من جوالك القديم. لا تُحفظ أي صورة.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "بعد ما تختار «شارك موقعي» في طلعة، يواصل سَرى البارق مشاركة موقعك مع أعضاء تلك الطلعة فقط في الخلفية والشاشة مقفلة (مع مؤشر الموقع الأزرق)، حتى توقف المشاركة أو تغادر أو تنتهي الطلعة. ويسجّل «مساري» (طريقك في الطلعة) حتى والشاشة مقفلة ليرجّعك «طريق العودة» من نفس الطريق؛ المسار يبقى على جوالك ولا يُرسل لأصحابك ولا لخوادمنا (تُطابق أجزاء منه مع الشوارع عبر Mapbox فقط).";
"NSLocalNetworkUsageDescription" = "يتصل سَرى البارق مباشرة بجوالات أعضاء طلعتك القريبين (بلوتوث وواي فاي مباشر) ليتبادل معهم المواقع والطوارئ مشفّرةً عندما ينقطع الإنترنت، وفقط وأنت تشارك موقعك.";
"NSPhotoLibraryAddUsageDescription" = "يحفظ «قصة الطلعة» (صورة أو فيديو صنعته على جوالك) في الصور فقط عندما تضغط «احفظ في الصور». لا يقرأ التطبيق صورك.";

/* «الموقع الدقيق» مقفل: طلب دقة كاملة مؤقتة لتسجيل «مساري». */
"TrailRecording" = "«الموقع الدقيق» مقفل، فيصير «مساري» تقريبيًا بالكيلومترات. اسمح بالموقع الدقيق لهذه الطلعة ليُرسم طريقك على الشوارع اللي مشيت فيها بالضبط، ويرجّعك «طريق العودة» من نفس الطريق.";
