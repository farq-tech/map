  "text": "تصل بعد خمس دقايق",
  "file": "eta_05.m4a"
 },
 {
  "key": "eta_06",
  "section": "eta",
  "text": "تصل بعد عشر دقايق",
  "file": "eta_06.m4a"
 },
 {
  "key": "eta_07",
  "section": "eta",
  "text": "تصل بعد ربع ساعة",
  "file": "eta_07.m4a"
 },
 {
  "key": "eta_08",
  "section": "eta",
  "text": "تصل بعد عشرين دقيقة",
  "file": "eta_08.m4a"
 },
 {
  "key": "eta_09",
  "section": "eta",
  "text": "تصل بعد نص ساعة",
  "file": "eta_09.m4a"
 },
 {
  "key": "eta_10",
  "section": "eta",
  "text": "تصل بعد خمس وأربعين دقيقة",
  "file": "eta_10.m4a"
 },
 {
  "key": "eta_11",
  "section": "eta",
  "text": "تصل بعد ساعة",
  "file": "eta_11.m4a"
 },
 {
  "key": "eta_12",
  "section": "eta",
  "text": "تصل بعد ساعة ونص",
  "file": "eta_12.m4a"
 },
 {
  "key": "eta_13",
  "section": "eta",
  "text": "تصل بعد ساعتين",
  "file": "eta_13.m4a"
 },
 {
  "key": "eta_14",
  "section": "eta",
  "text": "تصل بعد ثلاث ساعات",
  "file": "eta_14.m4a"
 },
 {
  "key": "eta_15",
  "section": "eta",
  "text": "تصل بعد أربع ساعات",
  "file": "eta_15.m4a"
 },
 {
  "key": "arr_01",
  "section": "arr",
  "text": "وصلتوا، الله يحييكم",
  "file": "arr_01.m4a"
 },
 {
  "key": "arr_02",
  "section": "arr",
  "text": "وصلت إلى وجهتك",
  "file": "arr_02.m4a"
 },
 {
  "key": "arr_03",
  "section": "arr",
  "text": "وصلت نقطة البداية",
  "file": "arr_03.m4a"
 },
 {
  "key": "arr_04",
  "section": "arr",
  "text": "باقي شوي وتوصل",
  "file": "arr_04.m4a"
 },
 {
  "key": "arr_05",
  "section": "arr",
  "text": "الوجهة بعد الطعس",
  "file": "arr_05.m4a"
 },
 {
  "key": "arr_06",
  "section": "arr",
  "text": "وقّف هنا",
  "file": "arr_06.m4a"
 },
 {
  "key": "rr_01",
  "section": "rr",
  "text": "خرجت عن الطريق، نحسب طريق جديد",
  "file": "rr_01.m4a"
 },
 {
  "key": "rr_02",
  "section": "rr",
  "text": "نعيد حساب الطريق",
  "file": "rr_02.m4a"
 },
 {
  "key": "rr_03",
  "section": "rr",
  "text": "مسار جديد",
  "file": "rr_03.m4a"
 },
 {
  "key": "rr_04",
  "section": "rr",
  "text": "ما قدرنا نحسب طريق جديد",
  "file": "rr_04.m4a"
 },
 {
  "key": "rr_05",
  "section": "rr",
  "text": "رجع الاتصال، نوجّهك على الطريق",
  "file": "rr_05.m4a"
 },
 {
  "key": "rr_06",
  "section": "rr",
  "text": "ما فيه إنترنت، اتجه مع السهم، ونعيد المحاولة لما يرجع الاتصال",
  "file": "rr_06.m4a"
 },
 {
  "key": "rr_07",
  "section": "rr",
  "text": "ضعفت إشارة الموقع",
  "file": "rr_07.m4a"
 },
 {
  "key": "rr_08",
  "section": "rr",
  "text": "رجعت إشارة الموقع",
  "file": "rr_08.m4a"
 },
 {
  "key": "rr_09",
  "section": "rr",
  "text": "تحميل الخريطة بدون إنترنت خلص",
  "file": "rr_09.m4a"
 },
 {
  "key": "sun_01",
  "section": "sun",
  "text": "المغرب قرّب، فكّروا ترجعون قبل الظلام",
  "file": "sun_01.m4a"
 },
 {
  "key": "sun_02",
  "section": "sun",
  "text": "باقي ساعة على المغرب",
  "file": "sun_02.m4a"
 },
 {
  "key": "sun_03",
  "section": "sun",
  "text": "باقي نص ساعة على المغرب",
  "file": "sun_03.m4a"
 },
 {
  "key": "sun_04",
  "section": "sun",
  "text": "باقي ربع ساعة على المغرب",
  "file": "sun_04.m4a"
 },
 {
  "key": "sun_05",
  "section": "sun",
  "text": "غابت الشمس",
  "file": "sun_05.m4a"
 },
 {
  "key": "sun_06",
  "section": "sun",
  "text": "ارجعوا على مساركم بهدوء، والأنوار شغالة",
  "file": "sun_06.m4a"
 },
 {
  "key": "sun_07",
  "section": "sun",
  "text": "طريق الرجعة تقريبًا نص ساعة",
  "file": "sun_07.m4a"
 },
 {
  "key": "sun_08",
  "section": "sun",
  "text": "طريق الرجعة تقريبًا ساعة",
  "file": "sun_08.m4a"
 },
 {
  "key": "sun_09",
  "section": "sun",
  "text": "طريق الرجعة تقريبًا ساعتين",
  "file": "sun_09.m4a"
 },
 {
  "key": "sun_10",
  "section": "sun",
  "text": "نبدأ طريق الرجعة",
  "file": "sun_10.m4a"
 },
 {
  "key": "spd_01",
  "section": "spd",
  "text": "السرعة القصوى هنا ثمانين",
  "file": "spd_01.m4a"
 },
 {
  "key": "spd_02",
  "section": "spd",
  "text": "السرعة القصوى هنا مية",
  "file": "spd_02.m4a"
 },
 {
  "key": "spd_03",
  "section": "spd",
  "text": "السرعة القصوى هنا مية وعشرين",
  "file": "spd_03.m4a"
 },
 {
  "key": "spd_04",
  "section": "spd",
  "text": "السرعة القصوى هنا مية وأربعين",
  "file": "spd_04.m4a"
 },
 {
  "key": "spd_05",
  "section": "spd",
  "text": "تجاوزت السرعة",
  "file": "spd_05.m4a"
 },
 {
  "key": "spd_06",
  "section": "spd",
  "text": "فيه ساهر قدام",
  "file": "spd_06.m4a"
 },
 {
  "key": "haz_01",
  "section": "haz",
  "text": "انتبه، حجارة",
  "file": "haz_01.m4a"
 },
 {
  "key": "haz_02",
  "section": "haz",
  "text": "انتبه، شعيب",
  "file": "haz_02.m4a"
 },
 {
  "key": "haz_03",
  "section": "haz",
  "text": "انتبه، سبخة",
  "file": "haz_03.m4a"
 },
 {
  "key": "haz_04",
  "section": "haz",
  "text": "انتبه، حفرة",
  "file": "haz_04.m4a"
 },
 {
  "key": "haz_05",
  "section": "haz",
  "text": "انتبه، جمال على الطريق",
  "file": "haz_05.m4a"
 },
 {
  "key": "haz_06",
  "section": "haz",
  "text": "انتبه، غبار والرؤية ضعيفة",
  "file": "haz_06.m4a"
 },
 {
  "key": "haz_07",
  "section": "haz",
  "text": "انتبه، ضباب",
  "file": "haz_07.m4a"
 },
 {
  "key": "haz_08",
  "section": "haz",
  "text": "انتبه، منحدر حاد قدامك",
  "file": "haz_08.m4a"
 },
 {
  "key": "haz_09",
  "section": "haz",
  "text": "انتبه، الطريق ضيق",
  "file": "haz_09.m4a"
 },
 {
  "key": "haz_10",
  "section": "haz",
  "text": "انتبه، منطقة ممنوع دخولها",
  "file": "haz_10.m4a"
 },
 {
  "key": "haz_11",
  "section": "haz",
  "text": "انتبه، أرض موحلة",
  "file": "haz_11.m4a"
 },
 {
  "key": "grp_01",
  "section": "grp",
  "text": "نداء استغاثة من واحد من العيال",
  "file": "grp_01.m4a"
 },
 {
  "key": "grp_02",
  "section": "grp",
  "text": "انرسل نداء الاستغاثة",
  "file": "grp_02.m4a"
 },
 {
  "key": "grp_03",
  "section": "grp",
  "text": "انلغى نداء الاستغاثة",
  "file": "grp_03.m4a"
 },
 {
  "key": "grp_04",
  "section": "grp",
  "text": "تم تحديد نقطة التجمع",
  "file": "grp_04.m4a"
 },
 {
  "key": "grp_05",
  "section": "grp",
  "text": "أمير الرحلة يوجهكم لنقطة",
  "file": "grp_05.m4a"
 },
 {
  "key": "grp_06",
  "section": "grp",
  "text": "واحد من العيال انقطع",
  "file": "grp_06.m4a"
 },
 {
  "key": "grp_07",
  "section": "grp",
  "text": "واحد من العيال رجع",
  "file": "grp_07.m4a"
 },
 {
  "key": "grp_08",
  "section": "grp",
  "text": "واحد من العيال بعيد عن القافلة",
  "file": "grp_08.m4a"
 },
 {
  "key": "grp_09",
  "section": "grp",
  "text": "القافلة كاملة",
  "file": "grp_09.m4a"
 },
 {
  "key": "grp_10",
  "section": "grp",
  "text": "القناة جاهزة",
  "file": "grp_10.m4a"
 },
 {
  "key": "grp_11",
  "section": "grp",
  "text": "القناة مو متاحة",
  "file": "grp_11.m4a"
 },
 {
  "key": "grp_12",
  "section": "grp",
  "text": "القناة مكتومة",
  "file": "grp_12.m4a"
 },
 {
  "key": "grp_13",
  "section": "grp",
  "text": "رسالة صوتية جديدة",
  "file": "grp_13.m4a"
 },
 {
  "key": "grp_14",
  "section": "grp",
  "text": "واحد من العيال وصل",
  "file": "grp_14.m4a"
 },
 {
  "key": "grp_15",
  "section": "grp",
  "text": "كل العيال وصلوا",
  "file": "grp_15.m4a"
 },
 {
  "key": "grp_16",
  "section": "grp",
  "text": "بدأت الطلعة",
  "file": "grp_16.m4a"
 },
 {
  "key": "grp_17",
  "section": "grp",
  "text": "انتهت الطلعة",
  "file": "grp_17.m4a"
 },
 {
  "key": "misc_01",
  "section": "misc",
  "text": "حفظت المكان",
  "file": "misc_01.m4a"
 },
 {
  "key": "misc_02",
  "section": "misc",
  "text": "انحفظ مسارك",
  "file": "misc_02.m4a"
 },
 {
  "key": "misc_03",
  "section": "misc",
  "text": "البطارية ضعيفة، شغّل الشاحن",
  "file": "misc_03.m4a"
 },
 {
  "key": "misc_04",
  "section": "misc",
  "text": "أقرب محطة بنزين قريبة",
  "file": "misc_04.m4a"
 },
 {
  "key": "misc_05",
  "section": "misc",
  "text": "أقرب محطة بنزين بعيدة، عبّ الحين",
  "file": "misc_05.m4a"
 },
 {
  "key": "misc_06",
  "section": "misc",
  "text": "تم",
  "file": "misc_06.m4a"
 },
 {
  "key": "x_01",
  "section": "x",
  "text": "خذ المخرج الأخير",
  "file": "x_01.m4a"
 },
 {
  "key": "x_02",
  "section": "x",
  "text": "لف بالدوّار وارجع",
  "file": "x_02.m4a"
 },
 {
  "key": "x_03",
  "section": "x",
  "text": "على يمينك",
  "file": "x_03.m4a"
 },
 {
  "key": "x_04",
  "section": "x",
  "text": "على يسارك",
  "file": "x_04.m4a"
 },
 {
  "key": "x_05",
  "section": "x",
  "text": "بعد ميل",
  "file": "x_05.m4a"
 },
 {
  "key": "x_06",
  "section": "x",
  "text": "بعد نص ميل",
  "file": "x_06.m4a"
 },
 {
  "key": "x_07",
  "section": "x",
  "text": "بعد ربع ميل",
  "file": "x_07.m4a"
 },
 {
  "key": "x_08",
  "section": "x",
  "text": "بعد ميلين",
  "file": "x_08.m4a"
 },
 {
  "key": "x_09",
  "section": "x",
  "text": "بعد خمس أميال",
  "file": "x_09.m4a"
 },
 {
  "key": "x_10",
  "section": "x",
  "text": "بعد عشر أميال",
  "file": "x_10.m4a"
 },
 {
  "key": "x_11",
  "section": "x",
  "text": "بعد خمس مية قدم",
  "file": "x_11.m4a"
 },
 {
  "key": "x_12",
  "section": "x",
  "text": "بعد ألف قدم",
  "file": "x_12.m4a"
 },
 {
  "key": "x_13",
  "section": "x",
  "text": "بعد اثنعش كيلو",
  "file": "x_13.m4a"
 },
 {
  "key": "x_14",
  "section": "x",
  "text": "بعد خمس وثلاثين كيلو",
  "file": "x_14.m4a"
 },
 {
  "key": "x_15",
  "section": "x",
  "text": "بعد خمس وأربعين كيلو",
  "file": "x_15.m4a"
 },
 {
  "key": "x_16",
  "section": "x",
  "text": "تمام",
  "file": "x_16.m4a"
 },
 {
  "key": "x_17",
  "section": "x",
  "text": "إن شاء الله",
  "file": "x_17.m4a"
 }
]