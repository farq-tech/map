# Copy to .env.local (web) or .env (api). Never commit real values.

# --- apps/web (Vite) ---
VITE_MAPBOX_ACCESS_TOKEN=
# Leave empty in local Vite so /api is proxied to the map API.
VITE_API_BASE_URL=
VITE_FEATURE_FLAGS=intelligence_ui

# --- apps/api ---
PORT=4001
# Comparison pins + catalog (same names as Farq API). Values only in local env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COMPARISON_READ_ENABLED=
SUPABASE_MENU_READ_ENABLED=
MENU_CATALOG_ENABLED=
UNIFIED_MENU_ENABLED=
SUPABASE_BASKET_COMPARE_ENABLED=
SUPABASE_COMPARISON_DB_URL=
COMPARISONS_DB_URL=
DATABASE_URL=
CORS_ORIGINS=
# Optional: proxy leftover /api calls to an existing Farq API that serves catalog.
FARQ_API_ORIGIN=
# Map chat (Railway). Server-side only — never VITE_ / never commit values.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
# Same Mapbox geocoder the web map uses — named-place chat (المغرزات).
MAPBOX_ACCESS_TOKEN=
