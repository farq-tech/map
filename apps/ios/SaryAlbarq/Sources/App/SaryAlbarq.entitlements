<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links for invite URLs. Needs apps/web/public/.well-known/apple-app-site-association
	     deployed with the real Team ID, and the Associated Domains capability on the App ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:farq-map-investor.vercel.app</string>
	</array>
</dict>
</plist>
