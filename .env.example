# Copy to .env.local (web) or .env (api). Never commit real values.

# --- apps/web (Vite) ---
VITE_MAPBOX_ACCESS_TOKEN=
# Leave empty in local Vite so /api is proxied to the map API.
VITE_API_BASE_URL=
VITE_FEATURE_FLAGS=intelligence_ui

# --- apps/api ---
PORT=4001
# Comparison pins + catalog (same names as Farq API). Values only in local env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COMPARISON_READ_ENABLED=
SUPABASE_MENU_READ_ENABLED=
MENU_CATALOG_ENABLED=
UNIFIED_MENU_ENABLED=
SUPABASE_BASKET_COMPARE_ENABLED=
SUPABASE_COMPARISON_DB_URL=
COMPARISONS_DB_URL=
DATABASE_URL=
CORS_ORIGINS=
# Optional: proxy leftover /api calls to an existing Farq API that serves catalog.
FARQ_API_ORIGIN=
# Map chat (Railway). Server-side only — never VITE_ / never commit values.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
# Same Mapbox geocoder the web map uses — named-place chat (المغرزات).
MAPBOX_ACCESS_TOKEN=
# Product analytics writes into public.analytics_events. Off unless exactly "1";
# when off POST /api/analytics still answers 204 and stores nothing.
ANALYTICS_WRITE_ENABLED=

# --- Shared outings (طلعة مشتركة) ---
# Postgres for outings (read/write). Falls back to SUPABASE_COMPARISON_DB_URL / DATABASE_URL.
SARY_DATABASE_URL=
# Migrations (apps/api/migrations) run at API boot unless this is "0".
SARY_AUTO_MIGRATE=
# Web: WebSocket for live positions. Vercel rewrites cannot carry WebSockets,
# so point this straight at the API host, e.g. wss://<railway-domain>/api/outings/live.
# Unset → same origin, and the client falls back to HTTP polling if it cannot connect.
VITE_LIVE_WS_URL=
# Optional tuning (defaults in apps/api/lib/outings/service.js)
OUTING_MAX_MEMBERS=
OUTING_INVITE_TTL_HOURS=
OUTING_POSITION_RETENTION_HOURS=
OUTING_IDLE_END_HOURS=
OUTING_PERSIST_EVERY_MS=
OUTING_MIN_FIX_INTERVAL_MS=
# Web Push for outing notes and SOS (API only — never VITE_, never commit values).
# Generate once: npx web-push generate-vapid-keys
# All three unset → push is off cleanly (/api/outings/push/config says enabled:false).
# The public key reaches browsers through that endpoint; the private key stays on the API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact the push services can reach, e.g. mailto:ops@example.com
VAPID_SUBJECT=
# Native iOS push (APNs) for the Sary Albarq app (API only — never commit values).
# Apple Developer → Certificates, IDs & Profiles → Keys → + → "Apple Push Notifications service (APNs)".
# All four unset (or an invalid key) → APNs is off cleanly (logged once; GET /api/outings/push/apns says enabled:false).
APNS_KEY_ID=
APNS_TEAM_ID=MH7J92HV9N
# The .p8 file contents; a single line with \n escapes is fine.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=sa.sary.albarq
