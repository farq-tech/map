<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SAME as SaryAlbarq.entitlements + CarPlay. Used only when CARPLAY_ENABLED=YES
	     (Config/Base.xcconfig): the simulator always, devices/archives once Apple grants
	     the CarPlay Navigation entitlement. KEEP THE KEYS BELOW IN SYNC with SaryAlbarq.entitlements
	     (scripts/check-entitlements.sh checks it). See docs/CARPLAY-ENTITLEMENT.md. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.developer.push-to-talk</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:farq-map-investor.vercel.app</string>
	</array>
	<!-- CarPlay Navigation app (the only CarPlay category that may draw a map). -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
