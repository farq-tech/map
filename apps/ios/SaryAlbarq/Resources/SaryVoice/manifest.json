 },
 {
  "key": "turns_01",
  "section": "turns",
  "text": "انعطف يمين",
  "file": "turns_01.m4a"
 },
 {
  "key": "turns_02",
  "section": "turns",
  "text": "انعطف يسار",
  "file": "turns_02.m4a"
 },
 {
  "key": "turns_03",
  "section": "turns",
  "text": "لف يمين شوي",
  "file": "turns_03.m4a"
 },
 {
  "key": "turns_04",
  "section": "turns",
  "text": "لف يسار شوي",
  "file": "turns_04.m4a"
 },
 {
  "key": "turns_05",
  "section": "turns",
  "text": "خذ يمينك بقوة",
  "file": "turns_05.m4a"
 },
 {
  "key": "turns_06",
  "section": "turns",
  "text": "خذ يسارك بقوة",
  "file": "turns_06.m4a"
 },
 {
  "key": "turns_07",
  "section": "turns",
  "text": "لف وارجع",
  "file": "turns_07.m4a"
 },
 {
  "key": "turns_08",
  "section": "turns",
  "text": "خلك على طول",
  "file": "turns_08.m4a"
 },
 {
  "key": "turns_09",
  "section": "turns",
  "text": "خلك يمين",
  "file": "turns_09.m4a"
 },
 {
  "key": "turns_10",
  "section": "turns",
  "text": "خلك يسار",
  "file": "turns_10.m4a"
 },
 {
  "key": "turns_11",
  "section": "turns",
  "text": "ادخل الطريق",
  "file": "turns_11.m4a"
 },
 {
  "key": "turns_12",
  "section": "turns",
  "text": "اطلع من المخرج يمين",
  "file": "turns_12.m4a"
 },
 {
  "key": "turns_13",
  "section": "turns",
  "text": "اطلع من المخرج يسار",
  "file": "turns_13.m4a"
 },
 {
  "key": "turns_14",
  "section": "turns",
  "text": "ثم",
  "file": "turns_14.m4a"
 },
 {
  "key": "round_01",
  "section": "round",
  "text": "ادخل الدوّار",
  "file": "round_01.m4a"
 },
 {
  "key": "round_02",
  "section": "round",
  "text": "اطلع من المخرج الأول",
  "file": "round_02.m4a"
 },
 {
  "key": "round_03",
  "section": "round",
  "text": "اطلع من المخرج الثاني",
  "file": "round_03.m4a"
 },
 {
  "key": "round_04",
  "section": "round",
  "text": "اطلع من المخرج الثالث",
  "file": "round_04.m4a"
 },
 {
  "key": "round_05",
  "section": "round",
  "text": "اطلع من المخرج الرابع",
  "file": "round_05.m4a"
 },
 {
  "key": "bar_01",
  "section": "bar",
  "text": "ما فيه طريق معبّد، اتجه مع السهم",
  "file": "bar_01.m4a"
 },
 {
  "key": "bar_02",
  "section": "bar",
  "text": "اتجه شمال",
  "file": "bar_02.m4a"
 },
 {
  "key": "bar_03",
  "section": "bar",
  "text": "اتجه جنوب",
  "file": "bar_03.m4a"
 },
 {
  "key": "bar_04",
  "section": "bar",
  "text": "اتجه شرق",
  "file": "bar_04.m4a"
 },
 {
  "key": "bar_05",
  "section": "bar",
  "text": "اتجه غرب",
  "file": "bar_05.m4a"
 },
 {
  "key": "bar_06",
  "section": "bar",
  "text": "ارجع للطريق المعبّد",
  "file": "bar_06.m4a"
 },
 {
  "key": "bar_07",
  "section": "bar",
  "text": "خلك على المسار",
  "file": "bar_07.m4a"
 },
 {
  "key": "bar_08",
  "section": "bar",
  "text": "الطعس قدامك",
  "file": "bar_08.m4a"
 },
 {
  "key": "bar_09",
  "section": "bar",
  "text": "طريق الرجعة جاهز",
  "file": "bar_09.m4a"
 },
 {
  "key": "safe_01",
  "section": "safe",
  "text": "انتبه، مطب",
  "file": "safe_01.m4a"
 },
 {
  "key": "safe_02",
  "section": "safe",
  "text": "انتبه، رمل ناعم",
  "file": "safe_02.m4a"
 },
 {
  "key": "safe_03",
