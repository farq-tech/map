<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links for invite URLs. Needs apps/web/public/.well-known/apple-app-site-association
	     deployed with the real Team ID, and the Associated Domains capability on the App ID. -->
	<!-- Push Notifications (APNs). Xcode re-signs it as "production" for App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- SOS arrives as a Time Sensitive notification (breaks through Focus when allowed). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- «يوتيوب»: the share extension hands a shared YouTube link's video id to the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.sa.sary.albarq</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:farq-map-investor.vercel.app</string>
	</array>
</dict>
</plist>
