{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"installCommand": "npm install",
	"buildCommand": "npm run build",
	"outputDirectory": "apps/web/dist",
	"rewrites": [
		{
			"source": "/_api/:path*",
			"destination": "https://api-production-ddc84.up.railway.app/:path*"
		},
		{
			"source": "/api/:path*",
			"destination": "https://api-production-ddc84.up.railway.app/api/:path*"
		},
		{
			"source": "/((?!api/|_api/).*)",
			"destination": "/index.html"
		}
	]
}
