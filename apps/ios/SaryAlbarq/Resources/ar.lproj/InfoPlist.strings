"CFBundleDisplayName" = "سَرى البارق";
"NSLocationWhenInUseUsageDescription" = "يعرض سَرى البارق موقعك على خريطة الطلعة، ويشاركه تلقائيًا مع أعضاء الطلعة التي انضممت لها فقط، ما دامت شغّالة. تتوقف المشاركة إذا غادرت الطلعة أو انتهت.";
"NSMicrophoneUsageDescription" = "يلتقط صوتك فقط وأنت ضاغط على «اضغط وتكلم»، ويصل مباشرة لأعضاء الطلعة مثل اللاسلكي. لمن عنده إصدار أقدم يُرسل مقطع قصير يُحذف من الخادم بعد ١٠ دقائق، ولا يُحفظ على جوالك.";
"NSCameraUsageDescription" = "تُستخدم الكاميرا لمسح رمز QR (دعوة طلعة أو رمز الاسترجاع)، ولتصوير نقطة تشاركها مع أعضاء الطلعة إذا اخترت ذلك بنفسك. لا تُحفظ الصور في معرض جوالك.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "ما دمت عضوًا في طلعة شغّالة، يواصل سَرى البارق مشاركة موقعك مع أعضاء تلك الطلعة فقط في الخلفية والشاشة مقفلة (مع مؤشر الموقع الأزرق)، حتى تغادر الطلعة أو تنتهي. ويسجّل «مساري» (طريقك في الطلعة) حتى والشاشة مقفلة ليرجّعك «طريق الرجعة» من نفس الطريق؛ المسار يبقى على جوالك ولا يُرسل للعيال ولا لخوادمنا (تُطابق أجزاء منه مع الشوارع عبر Mapbox فقط).";
"NSLocalNetworkUsageDescription" = "يتصل سَرى البارق مباشرة بجوالات أعضاء طلعتك القريبين (بلوتوث وواي فاي مباشر) ليتبادل معهم المواقع والطوارئ مشفّرةً عندما ينقطع الإنترنت، وفقط وأنت تشارك موقعك.";
"NSPhotoLibraryAddUsageDescription" = "يحفظ «قصة الطلعة» (صورة أو فيديو صنعته على جوالك) في الصور فقط عندما تضغط «احفظ في الصور». لا يقرأ التطبيق صورك.";

/* «الموقع الدقيق» مقفل: طلب دقة كاملة مؤقتة لتسجيل «مساري». */
"TrailRecording" = "«الموقع الدقيق» مقفل، فيصير «مساري» تقريبيًا بالكيلومترات. اسمح بالموقع الدقيق لهذه الطلعة ليُرسم طريقك على الشوارع اللي مشيت فيها بالضبط، ويرجّعك «طريق الرجعة» من نفس الطريق.";

