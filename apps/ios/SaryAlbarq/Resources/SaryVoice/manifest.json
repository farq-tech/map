[
 {
  "key": "start_01",
  "section": "start",
  "text": "بسم الله نبدأ.",
  "file": "start_01.m4a"
 },
 {
  "key": "start_02",
  "section": "start",
  "text": "بدأ التوجيه.",
  "file": "start_02.m4a"
 },
 {
  "key": "start_03",
  "section": "start",
  "text": "وصلت، الله يحيّيك.",
  "file": "start_03.m4a"
 },
 {
  "key": "start_04",
  "section": "start",
  "text": "وجهتك على يمينك.",
  "file": "start_04.m4a"
 },
 {
  "key": "start_05",
  "section": "start",
  "text": "وجهتك على يسارك.",
  "file": "start_05.m4a"
 },
 {
  "key": "start_06",
  "section": "start",
  "text": "وجهتك قدّامك.",
  "file": "start_06.m4a"
 },
 {
  "key": "start_07",
  "section": "start",
  "text": "وصلتوا مكان التجمّع.",
  "file": "start_07.m4a"
 },
 {
  "key": "start_08",
  "section": "start",
  "text": "طلعت عن الدرب. نضبط لك الطريق.",
  "file": "start_08.m4a"
 },
 {
  "key": "start_09",
  "section": "start",
  "text": "وقفنا التوجيه.",
  "file": "start_09.m4a"
 },
 {
  "key": "dist_01",
  "section": "dist",
  "text": "بعد خمسين متر.",
  "file": "dist_01.m4a"
 },
 {
  "key": "dist_02",
  "section": "dist",
  "text": "بعد مية متر.",
  "file": "dist_02.m4a"
 },
 {
  "key": "dist_03",
  "section": "dist",
  "text": "بعد مية وخمسين متر.",
  "file": "dist_03.m4a"
 },
 {
  "key": "dist_04",
  "section": "dist",
  "text": "بعد مئتين متر.",
  "file": "dist_04.m4a"
 },
 {
  "key": "dist_05",
  "section": "dist",
  "text": "بعد ثلاث مية متر.",
  "file": "dist_05.m4a"
 },
 {
  "key": "dist_06",
  "section": "dist",
  "text": "بعد أربع مية متر.",
  "file": "dist_06.m4a"
 },
 {
  "key": "dist_07",
  "section": "dist",
  "text": "بعد خمس مية متر.",
  "file": "dist_07.m4a"
 },
 {
  "key": "dist_08",
  "section": "dist",
  "text": "بعد سبع مية متر.",
  "file": "dist_08.m4a"
 },
 {
  "key": "dist_09",
  "section": "dist",
  "text": "بعد كيلو.",
  "file": "dist_09.m4a"
 },
 {
  "key": "dist_10",
  "section": "dist",
  "text": "بعد كيلو ونص.",
  "file": "dist_10.m4a"
 },
 {
  "key": "dist_11",
  "section": "dist",
  "text": "بعد كيلوين.",
  "file": "dist_11.m4a"
 },
 {
  "key": "dist_12",
  "section": "dist",
  "text": "بعد ثلاث كيلو.",
  "file": "dist_12.m4a"
 },
 {
  "key": "dist_13",
  "section": "dist",
  "text": "بعد خمس كيلو.",
  "file": "dist_13.m4a"
 },
 {
  "key": "dist_14",
  "section": "dist",
  "text": "بعد عشر كيلو.",
  "file": "dist_14.m4a"
 },
 {
  "key": "dist_15",
  "section": "dist",
  "text": "الحين،",
  "file": "dist_15.m4a"
 },
 {
  "key": "turns_01",
  "section": "turns",
  "text": "لف يمين.",
  "file": "turns_01.m4a"
 },
 {
  "key": "turns_02",
  "section": "turns",
  "text": "لف يسار.",
  "file": "turns_02.m4a"
 },
 {
  "key": "turns_03",
  "section": "turns",
  "text": "خذ اللفة الخفيفة يمين.",
  "file": "turns_03.m4a"
 },
 {
  "key": "turns_04",
  "section": "turns",
  "text": "خذ اللفة الخفيفة يسار.",
  "file": "turns_04.m4a"
 },
 {
  "key": "turns_05",
  "section": "turns",
  "text": "لف يمين بقوّة.",
  "file": "turns_05.m4a"
 },
 {
  "key": "turns_06",
  "section": "turns",
  "text": "لف يسار بقوّة.",
  "file": "turns_06.m4a"
 },
 {
  "key": "turns_07",
  "section": "turns",
  "text": "ديور وارجع من نفس الدرب.",
  "file": "turns_07.m4a"
 },
 {
  "key": "turns_08",
  "section": "turns",
  "text": "كمّل سيده.",
  "file": "turns_08.m4a"
 },
 {
  "key": "turns_09",
  "section": "turns",
  "text": "خلّك على اليمين.",
  "file": "turns_09.m4a"
 },
 {
  "key": "turns_10",
  "section": "turns",
  "text": "خلّك على اليسار.",
  "file": "turns_10.m4a"
 },
 {
  "key": "turns_11",
  "section": "turns",
  "text": "ادخل هالطريق.",
  "file": "turns_11.m4a"
 },
 {
  "key": "turns_12",
  "section": "turns",
  "text": "خذ المخرج اللي على اليمين.",
  "file": "turns_12.m4a"
 },
 {
  "key": "turns_13",
  "section": "turns",
  "text": "خذ المخرج اللي على اليسار.",
  "file": "turns_13.m4a"
 },
 {
  "key": "turns_14",
  "section": "turns",
  "text": "وبعدها،",
  "file": "turns_14.m4a"
 },
 {
  "key": "round_01",
  "section": "round",
  "text": "ادخل الدوّار.",
  "file": "round_01.m4a"
 },
 {
  "key": "round_02",
  "section": "round",
  "text": "خذ المخرج الأول.",
  "file": "round_02.m4a"
 },
 {
  "key": "round_03",
  "section": "round",
  "text": "خذ المخرج الثاني.",
  "file": "round_03.m4a"
 },
 {
  "key": "round_04",
  "section": "round",
  "text": "خذ المخرج الثالث.",
  "file": "round_04.m4a"
 },
 {
  "key": "round_05",
  "section": "round",
  "text": "خذ المخرج الرابع.",
  "file": "round_05.m4a"
 },
 {
  "key": "bar_01",
  "section": "bar",
  "text": "انتهى الطريق المزفلت. كمّل مع السهم.",
  "file": "bar_01.m4a"
 },
 {
  "key": "bar_02",
  "section": "bar",
  "text": "توجّه شمال.",
  "file": "bar_02.m4a"
 },
 {
  "key": "bar_03",
  "section": "bar",
  "text": "توجّه جنوب.",
  "file": "bar_03.m4a"
 },
 {
  "key": "bar_04",
  "section": "bar",
  "text": "توجّه شرق.",
  "file": "bar_04.m4a"
 },
 {
  "key": "bar_05",
  "section": "bar",
  "text": "توجّه غرب.",
  "file": "bar_05.m4a"
 },
 {
  "key": "bar_06",
  "section": "bar",
  "text": "ارجع للطريق المزفلت.",
  "file": "bar_06.m4a"
 },
 {
  "key": "bar_07",
  "section": "bar",
  "text": "خلّك على الدرب.",
  "file": "bar_07.m4a"
 },
 {
  "key": "bar_08",
  "section": "bar",
  "text": "انتبه، قدّامك طعس.",
  "file": "bar_08.m4a"
 },
 {
  "key": "bar_09",
  "section": "bar",
  "text": "درب الرجعة جاهز.",
  "file": "bar_09.m4a"
 },
 {
  "key": "safe_01",
  "section": "safe",
  "text": "انتبه، فيه مطب قدّامك.",
  "file": "safe_01.m4a"
 },
 {
  "key": "safe_02",
  "section": "safe",
  "text": "انتبه، قدّامك رمل ناعم.",
  "file": "safe_02.m4a"
 },
 {
  "key": "safe_03",
  "section": "safe",
  "text": "انتبه، قدّامك نزلة قوية.",
  "file": "safe_03.m4a"
 },
 {
  "key": "safe_04",
  "section": "safe",
  "text": "انتبه، قدّامك طلعة قوية.",
  "file": "safe_04.m4a"
 },
 {
  "key": "safe_05",
  "section": "safe",
  "text": "انتبه، سرعتك أعلى من المسموح.",
  "file": "safe_05.m4a"
 },
 {
  "key": "safe_06",
  "section": "safe",
  "text": "هدّ السرعة.",
  "file": "safe_06.m4a"
 },
 {
  "key": "safe_07",
  "section": "safe",
  "text": "انتبه، فيه سيل قدّامك. لا تعبر.",
  "file": "safe_07.m4a"
 },
 {
  "key": "safe_08",
  "section": "safe",
  "text": "الشمس بتغيب بعد نص ساعة.",
  "file": "safe_08.m4a"
 },
 {
  "key": "group_01",
  "section": "group",
  "text": "واحد من الربع تأخّر.",
  "file": "group_01.m4a"
 },
 {
  "key": "group_02",
  "section": "group",
  "text": "قائد الرحلة وقف.",
  "file": "group_02.m4a"
 },
 {
  "key": "group_03",
  "section": "group",
  "text": "الربع وقفوا، اصبر عليهم.",
  "file": "group_03.m4a"
 },
 {
  "key": "group_04",
  "section": "group",
  "text": "تجمّعوا هنا.",
  "file": "group_04.m4a"
 },
 {
  "key": "group_05",
  "section": "group",
  "text": "واحد من الربع غرز.",
  "file": "group_05.m4a"
 },
 {
  "key": "group_06",
  "section": "group",
  "text": "وصلتكم الفزعة.",
  "file": "group_06.m4a"
 },
 {
  "key": "m_01",
  "section": "m",
  "text": "بعد مية وخمسين متر.",
  "file": "m_01.m4a"
 },
 {
  "key": "m_02",
  "section": "m",
  "text": "بعد ميتين وخمسين متر.",
  "file": "m_02.m4a"
 },
 {
  "key": "m_03",
  "section": "m",
  "text": "بعد ست مية متر.",
  "file": "m_03.m4a"
 },
 {
  "key": "m_04",
  "section": "m",
  "text": "بعد ثمان مية متر.",
  "file": "m_04.m4a"
 },
 {
  "key": "m_05",
  "section": "m",
  "text": "بعد تسع مية متر.",
  "file": "m_05.m4a"
 },
 {
  "key": "m_06",
  "section": "m",
  "text": "بعد عشرين متر.",
  "file": "m_06.m4a"
 },
 {
  "key": "m_07",
  "section": "m",
  "text": "بعد ثلاثين متر.",
  "file": "m_07.m4a"
 },
 {
  "key": "km_01",
  "section": "km",
  "text": "بعد أربع كيلو.",
  "file": "km_01.m4a"
 },
 {
  "key": "km_02",
  "section": "km",
  "text": "بعد ست كيلو.",
  "file": "km_02.m4a"
 },
 {
  "key": "km_03",
  "section": "km",
  "text": "بعد سبع كيلو.",
  "file": "km_03.m4a"
 },
 {
  "key": "km_04",
  "section": "km",
  "text": "بعد ثمان كيلو.",
  "file": "km_04.m4a"
 },
 {
  "key": "km_05",
  "section": "km",
  "text": "بعد تسع كيلو.",
  "file": "km_05.m4a"
 },
 {
  "key": "km_06",
  "section": "km",
  "text": "بعد خمسطعش كيلو.",
  "file": "km_06.m4a"
 },
 {
  "key": "km_07",
  "section": "km",
  "text": "بعد عشرين كيلو.",
  "file": "km_07.m4a"
 },
 {
  "key": "km_08",
  "section": "km",
  "text": "بعد خمس وعشرين كيلو.",
  "file": "km_08.m4a"
 },
 {
  "key": "km_09",
  "section": "km",
  "text": "بعد ثلاثين كيلو.",
  "file": "km_09.m4a"
 },
 {
  "key": "km_10",
  "section": "km",
  "text": "بعد أربعين كيلو.",
  "file": "km_10.m4a"
 },
 {
  "key": "km_11",
  "section": "km",
  "text": "بعد خمسين كيلو.",
  "file": "km_11.m4a"
 },
 {
  "key": "km_12",
  "section": "km",
  "text": "بعد ستين كيلو.",
  "file": "km_12.m4a"
 },
 {
  "key": "km_13",
  "section": "km",
  "text": "بعد سبعين كيلو.",
  "file": "km_13.m4a"
 },
 {
  "key": "km_14",
  "section": "km",
  "text": "بعد ثمانين كيلو.",
  "file": "km_14.m4a"
 },
 {
  "key": "km_15",
  "section": "km",
  "text": "بعد مية كيلو.",
  "file": "km_15.m4a"
 },
 {
  "key": "km_16",
  "section": "km",
  "text": "بعد مية وخمسين كيلو.",
  "file": "km_16.m4a"
 },
 {
  "key": "km_17",
  "section": "km",
  "text": "بعد مئتين كيلو.",
  "file": "km_17.m4a"
 },
 {
  "key": "km_18",
  "section": "km",
  "text": "بعد كيلوين ونص.",
  "file": "km_18.m4a"
 },
 {
  "key": "km_19",
  "section": "km",
  "text": "بعد ثلاث كيلو ونص.",
  "file": "km_19.m4a"
 },
 {
  "key": "mv_01",
  "section": "mv",
  "text": "انطلق.",
  "file": "mv_01.m4a"
 },
 {
  "key": "mv_02",
  "section": "mv",
  "text": "كمّل سيده.",
  "file": "mv_02.m4a"
 },
 {
  "key": "mv_03",
  "section": "mv",
  "text": "لف يمين بقوّة.",
  "file": "mv_03.m4a"
 },
 {
  "key": "mv_04",
  "section": "mv",
  "text": "لف يسار بقوّة.",
  "file": "mv_04.m4a"
 },
 {
  "key": "mv_05",
  "section": "mv",
  "text": "خذ الطريق اللي بالنص عند التفرّع.",
  "file": "mv_05.m4a"
 },
 {
  "key": "mv_06",
  "section": "mv",
  "text": "خذ الطريق اللي على اليمين عند التفرّع.",
  "file": "mv_06.m4a"
 },
 {
  "key": "mv_07",
  "section": "mv",
  "text": "خذ الطريق اللي على اليسار عند التفرّع.",
  "file": "mv_07.m4a"
 },
 {
  "key": "mv_08",
  "section": "mv",
  "text": "انزل مع الطريق.",
  "file": "mv_08.m4a"
 },
 {
  "key": "mv_09",
  "section": "mv",
  "text": "خذ النزلة اللي على اليمين.",
  "file": "mv_09.m4a"
 },
 {
  "key": "mv_10",
  "section": "mv",
  "text": "خذ النزلة اللي على اليسار.",
  "file": "mv_10.m4a"
 },
 {
  "key": "mv_11",
  "section": "mv",
  "text": "اطلع من هالطريق.",
  "file": "mv_11.m4a"
 },
 {
  "key": "mv_12",
  "section": "mv",
  "text": "ادخل مع الطريق.",
  "file": "mv_12.m4a"
 },
 {
  "key": "mv_13",
  "section": "mv",
  "text": "ادخل مع الطريق من اليمين.",
  "file": "mv_13.m4a"
 },
 {
  "key": "mv_14",
  "section": "mv",
  "text": "ادخل مع الطريق من اليسار.",
  "file": "mv_14.m4a"
 },
 {
  "key": "mv_15",
  "section": "mv",
  "text": "إذا وصلت نهاية الطريق، لف يمين.",
  "file": "mv_15.m4a"
 },
 {
  "key": "mv_16",
  "section": "mv",
  "text": "إذا وصلت نهاية الطريق، لف يسار.",
  "file": "mv_16.m4a"
 },
 {
  "key": "mv_17",
  "section": "mv",
  "text": "خلّك في مسارك.",
  "file": "mv_17.m4a"
 },
 {
  "key": "mv_18",
  "section": "mv",
  "text": "خذ المسار اليمين.",
  "file": "mv_18.m4a"
 },
 {
  "key": "mv_19",
  "section": "mv",
  "text": "خذ المسار اليسار.",
  "file": "mv_19.m4a"
 },
 {
  "key": "mv_20",
  "section": "mv",
  "text": "خذ المسار اللي بالنص.",
  "file": "mv_20.m4a"
 },
 {
  "key": "rb_01",
  "section": "rb",
  "text": "اطلع من الدوّار.",
  "file": "rb_01.m4a"
 },
 {
  "key": "rb_02",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج الأول.",
  "file": "rb_02.m4a"
 },
 {
  "key": "rb_03",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج الثاني.",
  "file": "rb_03.m4a"
 },
 {
  "key": "rb_04",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج الثالث.",
  "file": "rb_04.m4a"
 },
 {
  "key": "rb_05",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج الرابع.",
  "file": "rb_05.m4a"
 },
 {
  "key": "rb_06",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج الخامس.",
  "file": "rb_06.m4a"
 },
 {
  "key": "rb_07",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج السادس.",
  "file": "rb_07.m4a"
 },
 {
  "key": "rb_08",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج السابع.",
  "file": "rb_08.m4a"
 },
 {
  "key": "rb_09",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج الثامن.",
  "file": "rb_09.m4a"
 },
 {
  "key": "rb_10",
  "section": "rb",
  "text": "في الدوّار، خذ المخرج التاسع.",
  "file": "rb_10.m4a"
 },
 {
  "key": "dir_01",
  "section": "dir",
  "text": "توجّه شمال شرق.",
  "file": "dir_01.m4a"
 },
 {
  "key": "dir_02",
  "section": "dir",
  "text": "توجّه شمال غرب.",
  "file": "dir_02.m4a"
 },
 {
  "key": "dir_03",
  "section": "dir",
  "text": "توجّه جنوب شرق.",
  "file": "dir_03.m4a"
 },
 {
  "key": "dir_04",
  "section": "dir",
  "text": "توجّه جنوب غرب.",
  "file": "dir_04.m4a"
 },
 {
  "key": "dir_05",
  "section": "dir",
  "text": "انتهى الطريق المزفلت. كمّل مع السهم.",
  "file": "dir_05.m4a"
 },
 {
  "key": "dir_06",
  "section": "dir",
  "text": "ما فيه طريق مزفلت يوصّلك للوجهة. كمّل مع السهم.",
  "file": "dir_06.m4a"
 },
 {
  "key": "dir_07",
  "section": "dir",
  "text": "ما فيه درب واضح قدّامك. خلك مع السهم.",
  "file": "dir_07.m4a"
 },
 {
  "key": "eta_01",
  "section": "eta",
  "text": "باقي أقل من دقيقة وتوصل.",
  "file": "eta_01.m4a"
 },
 {
  "key": "eta_02",
  "section": "eta",
  "text": "باقي دقيقة وتوصل.",
  "file": "eta_02.m4a"
 },
 {
  "key": "eta_03",
  "section": "eta",
  "text": "باقي دقيقتين وتوصل.",
  "file": "eta_03.m4a"
 },
 {
  "key": "eta_04",
  "section": "eta",
  "text": "باقي ثلاث دقايق وتوصل.",
  "file": "eta_04.m4a"
 },
 {
  "key": "eta_05",
  "section": "eta",
  "text": "باقي خمس دقايق وتوصل.",
  "file": "eta_05.m4a"
 },
 {
  "key": "eta_06",
  "section": "eta",
  "text": "باقي عشر دقايق وتوصل.",
  "file": "eta_06.m4a"
 },
 {
  "key": "eta_07",
  "section": "eta",
  "text": "باقي ربع ساعة وتوصل.",
  "file": "eta_07.m4a"
 },
 {
  "key": "eta_08",
  "section": "eta",
  "text": "باقي عشرين دقيقة وتوصل.",
  "file": "eta_08.m4a"
 },
 {
  "key": "eta_09",
  "section": "eta",
  "text": "باقي نص ساعة وتوصل.",
  "file": "eta_09.m4a"
 },
 {
  "key": "eta_10",
  "section": "eta",
  "text": "باقي خمس وأربعين دقيقة وتوصل.",
  "file": "eta_10.m4a"
 },
 {
  "key": "eta_11",
  "section": "eta",
  "text": "باقي ساعة وتوصل.",
  "file": "eta_11.m4a"
 },
 {
  "key": "eta_12",
  "section": "eta",
  "text": "باقي ساعة ونص وتوصل.",
  "file": "eta_12.m4a"
 },
 {
  "key": "eta_13",
  "section": "eta",
  "text": "باقي ساعتين وتوصل.",
  "file": "eta_13.m4a"
 },
 {
  "key": "eta_14",
  "section": "eta",
  "text": "باقي ثلاث ساعات وتوصل.",
  "file": "eta_14.m4a"
 },
 {
  "key": "eta_15",
  "section": "eta",
  "text": "باقي أربع ساعات وتوصل.",
  "file": "eta_15.m4a"
 },
 {
  "key": "arr_01",
  "section": "arr",
  "text": "وصلتوا، الله يحيّيكم.",
  "file": "arr_01.m4a"
 },
 {
  "key": "arr_02",
  "section": "arr",
  "text": "وصلت وجهتك.",
  "file": "arr_02.m4a"
 },
 {
  "key": "arr_03",
  "section": "arr",
  "text": "وصلت مكان البداية.",
  "file": "arr_03.m4a"
 },
 {
  "key": "arr_04",
  "section": "arr",
  "text": "باقي شوي وتوصل.",
  "file": "arr_04.m4a"
 },
 {
  "key": "arr_05",
  "section": "arr",
  "text": "وجهتك عقب الطعس.",
  "file": "arr_05.m4a"
 },
 {
  "key": "arr_06",
  "section": "arr",
  "text": "وقف هنا.",
  "file": "arr_06.m4a"
 },
 {
  "key": "rr_01",
  "section": "rr",
  "text": "طلعت عن الطريق. نحسب لك درب جديد.",
  "file": "rr_01.m4a"
 },
 {
  "key": "rr_02",
  "section": "rr",
  "text": "نحسب لك درب جديد.",
  "file": "rr_02.m4a"
 },
 {
  "key": "rr_03",
  "section": "rr",
  "text": "ضبطنا لك الطريق من جديد.",
  "file": "rr_03.m4a"
 },
 {
  "key": "rr_04",
  "section": "rr",
  "text": "ما قدرنا نضبط لك درب جديد. جرّب بعد شوي.",
  "file": "rr_04.m4a"
 },
 {
  "key": "rr_05",
  "section": "rr",
  "text": "رجع الاتصال. نكمل معك.",
  "file": "rr_05.m4a"
 },
 {
  "key": "rr_06",
  "section": "rr",
  "text": "ما فيه إنترنت. امش مع السهم، وبنحاول مرة ثانية إذا رجع الاتصال.",
  "file": "rr_06.m4a"
 },
 {
  "key": "rr_07",
  "section": "rr",
  "text": "تحديد موقعك ضعيف.",
  "file": "rr_07.m4a"
 },
 {
  "key": "rr_08",
  "section": "rr",
  "text": "رجع تحديد موقعك.",
  "file": "rr_08.m4a"
 },
 {
  "key": "rr_09",
  "section": "rr",
  "text": "جهّزنا الخريطة، وتقدر تستخدمها بدون إنترنت.",
  "file": "rr_09.m4a"
 },
 {
  "key": "sun_01",
  "section": "sun",
  "text": "المغرب قرّب. الأفضل تبدون الرجعة قبل يظلم.",
  "file": "sun_01.m4a"
 },
 {
  "key": "sun_02",
  "section": "sun",
  "text": "باقي ساعة على غروب الشمس.",
  "file": "sun_02.m4a"
 },
 {
  "key": "sun_03",
  "section": "sun",
  "text": "باقي نص ساعة على غروب الشمس.",
  "file": "sun_03.m4a"
 },
 {
  "key": "sun_04",
  "section": "sun",
  "text": "باقي ربع ساعة على الغروب.",
  "file": "sun_04.m4a"
 },
 {
  "key": "sun_05",
  "section": "sun",
  "text": "غربت الشمس.",
  "file": "sun_05.m4a"
 },
 {
  "key": "sun_06",
  "section": "sun",
  "text": "ارجعوا على مهلكم، وشغّلوا الأنوار.",
  "file": "sun_06.m4a"
 },
 {
  "key": "sun_07",
  "section": "sun",
  "text": "وقت الرجعة تقريبًا نص ساعة.",
  "file": "sun_07.m4a"
 },
 {
  "key": "sun_08",
  "section": "sun",
  "text": "وقت الرجعة تقريبًا ساعة.",
  "file": "sun_08.m4a"
 },
 {
  "key": "sun_09",
  "section": "sun",
  "text": "وقت الرجعة تقريبًا ساعتين.",
  "file": "sun_09.m4a"
 },
 {
  "key": "sun_10",
  "section": "sun",
  "text": "بدأنا درب الرجعة.",
  "file": "sun_10.m4a"
 },
 {
  "key": "spd_01",
  "section": "spd",
  "text": "السرعة المحددة هنا ثمانين.",
  "file": "spd_01.m4a"
 },
 {
  "key": "spd_02",
  "section": "spd",
  "text": "السرعة المحددة هنا مية.",
  "file": "spd_02.m4a"
 },
 {
  "key": "spd_03",
  "section": "spd",
  "text": "السرعة المحددة هنا مية وعشرين.",
  "file": "spd_03.m4a"
 },
 {
  "key": "spd_04",
  "section": "spd",
  "text": "السرعة المحددة هنا مية وأربعين.",
  "file": "spd_04.m4a"
 },
 {
  "key": "spd_05",
  "section": "spd",
  "text": "انتبه، تعدّيت السرعة المحددة.",
  "file": "spd_05.m4a"
 },
 {
  "key": "spd_06",
  "section": "spd",
  "text": "انتبه، قدّامك كاميرا سرعة.",
  "file": "spd_06.m4a"
 },
 {
  "key": "haz_01",
  "section": "haz",
  "text": "انتبه، فيه حصى وصخور بالطريق.",
  "file": "haz_01.m4a"
 },
 {
  "key": "haz_02",
  "section": "haz",
  "text": "انتبه، قدّامك شعيب.",
  "file": "haz_02.m4a"
 },
 {
  "key": "haz_03",
  "section": "haz",
  "text": "انتبه، قدّامك أرض سبخة.",
  "file": "haz_03.m4a"
 },
 {
  "key": "haz_04",
  "section": "haz",
  "text": "انتبه، فيه حفرة قدّامك.",
  "file": "haz_04.m4a"
 },
 {
  "key": "haz_05",
  "section": "haz",
  "text": "انتبه، فيه إبل بالطريق.",
  "file": "haz_05.m4a"
 },
 {
  "key": "haz_06",
  "section": "haz",
  "text": "انتبه، الغبار كثيف والرؤية ضعيفة.",
  "file": "haz_06.m4a"
 },
 {
  "key": "haz_07",
  "section": "haz",
  "text": "انتبه، فيه ضباب والرؤية ضعيفة.",
  "file": "haz_07.m4a"
 },
 {
  "key": "haz_08",
  "section": "haz",
  "text": "انتبه، قدّامك نزلة حادّة.",
  "file": "haz_08.m4a"
 },
 {
  "key": "haz_09",
  "section": "haz",
  "text": "انتبه، الطريق يضيق قدّامك.",
  "file": "haz_09.m4a"
 },
 {
  "key": "haz_10",
  "section": "haz",
  "text": "انتبه، قدّامك منطقة ممنوع تدخلها.",
  "file": "haz_10.m4a"
 },
 {
  "key": "haz_11",
  "section": "haz",
  "text": "انتبه، الأرض طينية وزلقة.",
  "file": "haz_11.m4a"
 },
 {
  "key": "grp_01",
  "section": "grp",
  "text": "أحد من الربع يطلب الفزعة.",
  "file": "grp_01.m4a"
 },
 {
  "key": "grp_02",
  "section": "grp",
  "text": "أرسلنا نداء الفزعة.",
  "file": "grp_02.m4a"
 },
 {
  "key": "grp_03",
  "section": "grp",
  "text": "لغينا نداء الفزعة.",
  "file": "grp_03.m4a"
 },
 {
  "key": "grp_04",
  "section": "grp",
  "text": "حددنا مكان التجمّع.",
  "file": "grp_04.m4a"
 },
 {
  "key": "grp_05",
  "section": "grp",
  "text": "قائد الرحلة يوجّهكم لمكان التجمّع.",
  "file": "grp_05.m4a"
 },
 {
  "key": "grp_06",
  "section": "grp",
  "text": "أحد من الربع انفصل عن القافلة.",
  "file": "grp_06.m4a"
 },
 {
  "key": "grp_07",
  "section": "grp",
  "text": "رجع واحد من الربع للقافلة.",
  "file": "grp_07.m4a"
 },
 {
  "key": "grp_08",
  "section": "grp",
  "text": "واحد من الربع بعيد عن القافلة.",
  "file": "grp_08.m4a"
 },
 {
  "key": "grp_09",
  "section": "grp",
  "text": "القافلة كاملة.",
  "file": "grp_09.m4a"
 },
 {
  "key": "grp_10",
  "section": "grp",
  "text": "اللاسلكي جاهز.",
  "file": "grp_10.m4a"
 },
 {
  "key": "grp_11",
  "section": "grp",
  "text": "اللاسلكي مو متاح.",
  "file": "grp_11.m4a"
 },
 {
  "key": "grp_12",
  "section": "grp",
  "text": "صوت اللاسلكي مكتوم.",
  "file": "grp_12.m4a"
 },
 {
  "key": "grp_13",
  "section": "grp",
  "text": "عندك رسالة صوتية جديدة.",
  "file": "grp_13.m4a"
 },
 {
  "key": "grp_14",
  "section": "grp",
  "text": "وصل واحد من الربع.",
  "file": "grp_14.m4a"
 },
 {
  "key": "grp_15",
  "section": "grp",
  "text": "وصلوا كل الربع.",
  "file": "grp_15.m4a"
 },
 {
  "key": "grp_16",
  "section": "grp",
  "text": "بدأنا الرحلة.",
  "file": "grp_16.m4a"
 },
 {
  "key": "grp_17",
  "section": "grp",
  "text": "خلصت الرحلة.",
  "file": "grp_17.m4a"
 },
 {
  "key": "misc_01",
  "section": "misc",
  "text": "حفظنا الموقع.",
  "file": "misc_01.m4a"
 },
 {
  "key": "misc_02",
  "section": "misc",
  "text": "حفظنا دربك.",
  "file": "misc_02.m4a"
 },
 {
  "key": "misc_03",
  "section": "misc",
  "text": "البطارية ضعيفة. شبّك الشاحن.",
  "file": "misc_03.m4a"
 },
 {
  "key": "misc_04",
  "section": "misc",
  "text": "محطة البنزين قريبة.",
  "file": "misc_04.m4a"
 },
 {
  "key": "misc_05",
  "section": "misc",
  "text": "محطة البنزين بعيدة. الأفضل تعبي من الحين.",
  "file": "misc_05.m4a"
 },
 {
  "key": "misc_06",
  "section": "misc",
  "text": "تم.",
  "file": "misc_06.m4a"
 },
 {
  "key": "x_01",
  "section": "x",
  "text": "خذ آخر مخرج.",
  "file": "x_01.m4a"
 },
 {
  "key": "x_02",
  "section": "x",
  "text": "ديور بالدوّار وارجع.",
  "file": "x_02.m4a"
 },
 {
  "key": "x_03",
  "section": "x",
  "text": "على يمينك.",
  "file": "x_03.m4a"
 },
 {
  "key": "x_04",
  "section": "x",
  "text": "على يسارك.",
  "file": "x_04.m4a"
 },
 {
  "key": "x_05",
  "section": "x",
  "text": "بعد ميل.",
  "file": "x_05.m4a"
 },
 {
  "key": "x_06",
  "section": "x",
  "text": "بعد نص ميل.",
  "file": "x_06.m4a"
 },
 {
  "key": "x_07",
  "section": "x",
  "text": "بعد ربع ميل.",
  "file": "x_07.m4a"
 },
 {
  "key": "x_08",
  "section": "x",
  "text": "بعد ميلين.",
  "file": "x_08.m4a"
 },
 {
  "key": "x_09",
  "section": "x",
  "text": "بعد خمس أميال.",
  "file": "x_09.m4a"
 },
 {
  "key": "x_10",
  "section": "x",
  "text": "بعد عشر أميال.",
  "file": "x_10.m4a"
 },
 {
  "key": "x_11",
  "section": "x",
  "text": "بعد خمس مية قدم.",
  "file": "x_11.m4a"
 },
 {
  "key": "x_12",
  "section": "x",
  "text": "بعد ألف قدم.",
  "file": "x_12.m4a"
 },
 {
  "key": "x_13",
  "section": "x",
  "text": "بعد اثنعش كيلو.",
  "file": "x_13.m4a"
 },
 {
  "key": "x_14",
  "section": "x",
  "text": "بعد خمس وثلاثين كيلو.",
  "file": "x_14.m4a"
 },
 {
  "key": "x_15",
  "section": "x",
  "text": "بعد خمس وأربعين كيلو.",
  "file": "x_15.m4a"
 },
 {
  "key": "x_16",
  "section": "x",
  "text": "تمام.",
  "file": "x_16.m4a"
 },
 {
  "key": "x_17",
  "section": "x",
  "text": "إن شاء الله.",
  "file": "x_17.m4a"
 }
]
