"CFBundleDisplayName" = "سَرى البارق";
"NSLocationWhenInUseUsageDescription" = "يعرض سَرى البارق موقعك على خريطة الطلعة، ويشاركه مع أعضاء الطلعة فقط عندما تختار «شارك موقعي» والتطبيق مفتوح أمامك.";
"NSMicrophoneUsageDescription" = "يسجّل صوتك فقط وأنت ضاغط على «اضغط وتكلم»، ويُرسل المقطع لأعضاء الطلعة. يُحذف من الخادم بعد ١٠ دقائق.";
"NSCameraUsageDescription" = "تُستخدم الكاميرا فقط لمسح رمز QR: رمز دعوة طلعة، أو رمز الاسترجاع من جوالك القديم. لا تُحفظ أي صورة.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "يسجّل سَرى البارق «مساري» (طريقك في الطلعة) حتى والشاشة مقفلة، ليرجّعك «طريق العودة» من نفس الطريق. المسار يبقى على جوالك فقط ولا يُرسل لأحد؛ ومشاركة موقعك مع الأصحاب تبقى والتطبيق مفتوح فقط.";
