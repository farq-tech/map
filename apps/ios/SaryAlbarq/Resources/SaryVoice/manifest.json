  "text": "انتبه، نزلة قوية",
  "file": "safe_03.m4a"
 },
 {
  "key": "safe_04",
  "section": "safe",
  "text": "انتبه، طلعة قوية",
  "file": "safe_04.m4a"
 },
 {
  "key": "safe_05",
  "section": "safe",
  "text": "انتبه، السرعة زايدة",
  "file": "safe_05.m4a"
 },
 {
  "key": "safe_06",
  "section": "safe",
  "text": "هدّي السرعة",
  "file": "safe_06.m4a"
 },
 {
  "key": "safe_07",
  "section": "safe",
  "text": "فيه سيل قدام، لا تقطع",
  "file": "safe_07.m4a"
 },
 {
  "key": "safe_08",
  "section": "safe",
  "text": "الشمس بتغيب بعد نص ساعة",
  "file": "safe_08.m4a"
 },
 {
  "key": "group_01",
  "section": "group",
  "text": "واحد من العيال تأخر",
  "file": "group_01.m4a"
 },
 {
  "key": "group_02",
  "section": "group",
  "text": "أمير الرحلة وقف",
  "file": "group_02.m4a"
 },
 {
  "key": "group_03",
