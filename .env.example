# Copy to .env.local (web) or .env (api). Never commit real values.

# --- apps/web (Vite) ---
VITE_MAPBOX_ACCESS_TOKEN=
# Leave empty in local Vite so /api is proxied to the map API.
VITE_API_BASE_URL=
VITE_FEATURE_FLAGS=intelligence_ui

# --- apps/api ---
PORT=4001
# Comparison pins (same names as Farq API). Values only in local/.Vercel env.
SUPABASE_COMPARISON_READ_ENABLED=
SUPABASE_COMPARISON_DB_URL=
COMPARISONS_DB_URL=
# Optional: proxy restaurant menu (and leftover /api calls) to an existing Farq API.
FARQ_API_ORIGIN=
