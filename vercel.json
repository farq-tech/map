{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"installCommand": "npm install",
	"buildCommand": "npm run build",
	"outputDirectory": "apps/web/dist",
	"headers": [
		{
			"source": "/.well-known/apple-app-site-association",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/json"
				}
			]
		},
		{
			"source": "/watch",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				},
				{
					"key": "Referrer-Policy",
					"value": "no-referrer"
				}
			]
		},
		{
			"source": "/sw.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				},
				{
					"key": "Content-Type",
					"value": "application/javascript; charset=utf-8"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/comparison/restaurants/:id/catalog",
			"destination": "https://api-production-ddc84.up.railway.app/api/comparison/restaurants/:id/catalog"
		},
		{
			"source": "/api/restaurant/:id/menu",
			"destination": "https://api-production-ddc84.up.railway.app/api/comparison/restaurants/:id/catalog"
		},
		{
			"source": "/_api/:path*",
			"destination": "https://api-production-ddc84.up.railway.app/:path*"
		},
		{
			"source": "/api/:path*",
			"destination": "https://api-production-ddc84.up.railway.app/api/:path*"
		},
		{
			"source": "/outings/join",
			"destination": "/outings-join.html"
		},
		{
			"source": "/((?!api/|_api/).*)",
			"destination": "/index.html"
		}
	]
}
