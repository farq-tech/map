[
 {
  "key": "start_01",
  "section": "start",
  "text": "يلا نمشي، الله يحفظك",
  "file": "start_01.m4a"
 },
 {
  "key": "start_02",
  "section": "start",
  "text": "بدأ التوجيه",
  "file": "start_02.m4a"
 },
 {
  "key": "start_03",
  "section": "start",
  "text": "وصلت، الله يحييك",
  "file": "start_03.m4a"
 },
 {
  "key": "start_04",
  "section": "start",
  "text": "وجهتك على يمينك",
  "file": "start_04.m4a"
 },
 {
  "key": "start_05",
  "section": "start",
  "text": "وجهتك على يسارك",
  "file": "start_05.m4a"
 },
 {
  "key": "start_06",
  "section": "start",
  "text": "وجهتك قدامك",
  "file": "start_06.m4a"
 },
 {
  "key": "start_07",
  "section": "start",
  "text": "وصلت نقطة التجمع",
  "file": "start_07.m4a"
 },
 {
  "key": "start_08",
  "section": "start",
  "text": "طلعت عن المسار، أعيد لك الطريق",
  "file": "start_08.m4a"
 },
 {
  "key": "start_09",
  "section": "start",
  "text": "وقف التوجيه",
  "file": "start_09.m4a"
 },
