# مفتاح Mapbox العام (pk.*) فقط — لا تضع مفتاحًا سريًا. انسخ هذا الملف إلى .env.local (مُتجاهَل من git)
MAPBOX_ACCESS_TOKEN=pk.ضع_المفتاح_العام_هنا
# ميزانية طلبات البلاطات الجديدة يوميًا (الافتراضي 600)
# MAPBOX_DAILY_BUDGET=600
# مجلدات بلاطات مخزنة للقراءة فقط (نفس تسمية {z}_{x}_{y}@2x.jpg)
# TILE_FALLBACK_DIRS=~/code/map-wt/sat-tracks-sample/tiles
