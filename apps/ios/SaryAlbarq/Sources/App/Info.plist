<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>سَرى البارق</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Mapbox public token, from Config/Secrets.xcconfig (gitignored). -->
	<key>MBXAccessToken</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Custom-scheme fallback for invite links: saryalbarq://join#<token> -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>sa.sary.albarq.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>saryalbarq</string>
			</array>
		</dict>
	</array>

	<!-- Base strings (Arabic, the development language). English in en.lproj/InfoPlist.strings. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>يعرض سَرى البارق موقعك على خريطة الطلعة، ويشاركه مع أعضاء الطلعة فقط عندما تختار «شارك موقعي» والتطبيق مفتوح أمامك.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>يسجّل سَرى البارق «مساري» (طريقك في الطلعة) حتى والشاشة مقفلة، ليرجّعك «طريق العودة» من نفس الطريق. المسار يبقى على جوالك فقط ولا يُرسل لأحد؛ ومشاركة موقعك مع الأصحاب تبقى والتطبيق مفتوح فقط.</string>
	<!-- Background location is used ONLY for the on-device trail («سجّل مساري والشاشة مقفلة»,
	     owner-approved). Positions are never sent from the background (SendGate). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>يسجّل صوتك فقط وأنت ضاغط على «اضغط وتكلم»، ويُرسل المقطع لأعضاء الطلعة. يُحذف من الخادم بعد ١٠ دقائق.</string>

	<key>NSCameraUsageDescription</key>
	<string>تُستخدم الكاميرا لمسح رمز QR (دعوة طلعة أو رمز الاسترجاع)، ولتصوير نقطة تشاركها مع أعضاء الطلعة إذا اخترت ذلك بنفسك. لا تُحفظ الصور في معرض جوالك.</string>

	<!-- Launch screen: the Dark Sand background and the app mark, the same as the splash that follows. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
